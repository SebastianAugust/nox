{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nox",
  "version": "0.1.0",
  "identifier": "com.lenovo.nox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nox",
        "width": 160,
        "height": 200,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": true
      },
      {
        "label": "dashboard",
        "title": "Nox Dashboard",
        "width": 720,
        "height": 600,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:nox.db"]
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Bas",
    "shortDescription": "Nox — desktop pet assistant",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
